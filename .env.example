# Провайдер LLM: "gemini" или "ollama"
LLM_PROVIDER=gemini

# Google AI Studio (Dev):
GEMINI_API_KEY=your_gemini_api_key_here
# Comma-separated pool for round-robin + quota failover (overrides single key when set):
# GEMINI_API_KEYS=key1,key2,key3
# gemini-3.5-flash-lite (new free keys) | gemini-2.5-flash-lite (legacy) | gemini-2.5-flash (404 fallback)
GEMINI_MODEL=gemini-3.5-flash-lite
# Reverse-proxy for google-genai SDK (warehouse RF / Cloudflare Worker).
# Also accepted: GOOGLE_GENAI_BASE_URL
# GEMINI_BASE_URL=https://your-gemini-proxy.example/

# Telegram (удалённая телеметрия склада):
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789

# Ollama (Prod / Offline склад):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
